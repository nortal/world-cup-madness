# Plaintext secrets - NEVER commit
secrets/plain/*
!secrets/plain/.gitkeep

# Common secret patterns
*.env
.env.*
!.env.example
*.pem
*.key
credentials.*

# OS files
.DS_Store
Thumbs.db

# Editor files
*.swp
*~
.idea/
.vscode/

# Python
__pycache__/
*.pyc
.venv/
venv/

# Node (if used)
node_modules/

# Next.js / TypeScript build artifacts
.next/
out/
dist/
build/
coverage/
*.tsbuildinfo
next-env.d.ts

# Playwright artifacts
/test-results/
/playwright-report/
/blob-report/
/playwright/.cache/
