# Supabase — populated from `npx supabase start` output (local) or Supabase project settings (prod)
NEXT_PUBLIC_SUPABASE_URL=http://localhost:54321
NEXT_PUBLIC_SUPABASE_ANON_KEY=replace-with-anon-key-from-supabase-start

# Server-side only — NEVER commit, NEVER ship to client bundles (see constitution-backend.md §VI.1)
SUPABASE_SERVICE_ROLE_KEY=replace-with-service-role-key-from-supabase-start

# Microsoft Entra ID OAuth — from Nortal IT (use test placeholders for local JWT-injection flow)
AUTH_AZURE_CLIENT_ID=replace-with-azure-app-client-id
AUTH_AZURE_SECRET=replace-with-azure-app-client-secret
AUTH_AZURE_TENANT_ID=replace-with-nortal-entra-tenant-uuid

# football-data.org REST API v4 (feature 002 — match catalog sync)
# Sign up at https://www.football-data.org for a free-tier API key (10 req/min).
# Local dev can run without a key by setting SYNC_FIXTURE_MODE=1 below, which
# reads from supabase/functions/sync-matches/__fixtures__/v4-sample.json instead
# of hitting the provider.
FOOTBALL_DATA_API_KEY=replace-with-football-data-api-key
SYNC_FIXTURE_MODE=1

# feature 003 — predictions + scoring (no new env vars required)
# All prediction RPCs + scoring triggers + admin recalc-all run inside Postgres.
# The squad-sync extension to sync-matches reuses FOOTBALL_DATA_API_KEY +
# SYNC_FIXTURE_MODE above. Fixture mode also reads
# supabase/functions/sync-matches/__fixtures__/v4-squads-sample.json once
# US-PB ships.

# feature 004 — leaderboard (no new env vars)
# Materialised view + RPC + pg_cron schedule live entirely inside Postgres.
# Realtime subscription reuses NEXT_PUBLIC_SUPABASE_URL +
# NEXT_PUBLIC_SUPABASE_ANON_KEY above.
